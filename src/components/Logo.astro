---
// parent=false drops the "A DubLow Digital Brand" line where the DubLow logo itself is shown alongside.
interface Props { light?: boolean; parent?: boolean }
const { light = false, parent = true } = Astro.props;
const main = light ? '#ffffff' : '#2b1a8f';
const sub = light ? '#c9c2ff' : '#4b2bc0';
---
<svg viewBox={parent ? '0 0 260 74' : '0 0 260 62'} role="img" aria-label="Vail Valley IT — Business Technology Partners, a DubLow Digital brand">
  <path d="M96 22 L110 8 L117 15 L124 4 L134 15 L141 10 L156 22" fill="none" stroke={sub} stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
  <path d="M120 9 L124 4 L128 9" fill="none" stroke={main} stroke-width="2.4" stroke-linecap="round"/>
  <text x="130" y="44" text-anchor="middle" font-family="Plus Jakarta Sans Variable, Plus Jakarta Sans, system-ui, sans-serif" font-weight="800" font-size="27" letter-spacing="1.2" fill={main}>VAIL VALLEY IT</text>
  <text x="130" y="58" text-anchor="middle" font-family="Plus Jakarta Sans Variable, Plus Jakarta Sans, system-ui, sans-serif" font-weight="700" font-size="8.6" letter-spacing="2.6" fill={sub}>BUSINESS TECHNOLOGY PARTNERS</text>
  {parent && <text x="130" y="70" text-anchor="middle" font-family="Plus Jakarta Sans Variable, Plus Jakarta Sans, system-ui, sans-serif" font-weight="600" font-size="8" fill={main} opacity=".85">A DubLow Digital Brand</text>}
</svg>
