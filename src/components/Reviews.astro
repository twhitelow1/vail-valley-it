---
// Live review widget (GoHighLevel Reputation). Updates itself as new Google reviews arrive.
// The verbatim highlights in site.ts stay as crawlable text on /reviews-testimonials.
import { site } from '../data/site';
---
<div class="reviews-widget">
  <script is:inline src="https://reputationhub.site/reputation/assets/review-widget.js"></script>
  <iframe class="lc_reviews_widget" src={site.reviewWidgetUrl} title={`${site.parentBrand} Google reviews`} loading="lazy" frameborder="0" scrolling="no" style="min-width: 100%; width: 100%; border: 0;"></iframe>
</div>
<p class="meta">Live reviews from our <a href={site.gbp.mapsUrl} rel="noopener">Google Business Profile</a> (listed as {site.parentBrand}). <a href={site.gbp.reviewUrl} rel="noopener">Leave a review</a>.</p>
