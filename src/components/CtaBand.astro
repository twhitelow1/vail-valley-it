---
import Icon from './Icon.astro';
import { site, bookHref, telHref } from '../data/site';
interface Props { title?: string; text?: string; button?: string }
const { title = 'Is your IT paying you back — or just sending invoices?', text = 'Get a second opinion with a free technology assessment. We review your devices, accounts, licenses, backups and security, then show you what’s at risk, what you’re paying for but not using, and one flat monthly price.', button = 'Get a free technology assessment' } = Astro.props;
---
<section class="section" aria-label={button}>
  <div class="wrap">
    <div class="cta">
      <Icon name="calendar" class="cta-icon" />
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-light" href={bookHref}><Icon name="calendar" />{button}</a>
        <a class="btn btn-ghost-light" href={telHref}><Icon name="phone" />Call {site.phone}</a>
      </div>
    </div>
  </div>
</section>
