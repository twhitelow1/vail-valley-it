---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { breadcrumbs, webPage } from '../lib/schema';
const title = 'Client Reviews & Testimonials | Vail Valley IT';
const description = 'See what Eagle County business owners say about working with Vail Valley IT for managed IT, cybersecurity and support services.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews-testimonials' }];
---
<Base title={title} description={description} path="/reviews-testimonials" schema={[webPage('/reviews-testimonials', title, description), breadcrumbs(crumbs)]}>
  <header class="page-head"><div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Vail Valley IT reviews</h1>
    <p class="answer">Vail Valley IT holds a {site.gbp.rating.toFixed(1)}-star rating from {site.gbp.reviewCount} Google reviews on its Google Business Profile, listed under parent company {site.parentBrand}. Clients consistently mention responsiveness, patience and security they did not know they were missing.</p>
    <p><a class="btn btn-outline" href={site.gbp.reviewUrl} rel="noopener">Leave a Google review</a></p>
  </div></header>
  <section class="section"><div class="wrap"><Reviews /></div></section>
  <CtaBand />
</Base>
