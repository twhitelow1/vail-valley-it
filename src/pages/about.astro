---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import founderPhoto from '../assets/todd-whitelow-portrait.jpg';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
import { breadcrumbs, webPage, founder, faqPage } from '../lib/schema';
const title = 'About Vail Valley IT | Local Managed IT Services Team';
const description = 'Vail Valley IT is the Eagle County branch of DubLow Digital, a nationwide small-business IT firm headquartered in Edwards, Colorado. Longtime locals.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }];
const faqs = [
  { q: 'Is Vail Valley IT a local company?', a: 'Yes. Vail Valley IT is based in Edwards, Colorado, and its founder lives in the Vail Valley. It serves businesses throughout Eagle County.' },
  { q: 'Who owns Vail Valley IT?', a: 'Vail Valley IT is a brand of DubLow Digital, founded by Todd Whitelow. DubLow Digital is a nationwide IT firm for small businesses, headquartered in Edwards, Colorado. Vail Valley IT is its local branch for Eagle County.' },
  { q: 'Where is DubLow Digital headquartered?', a: 'DubLow Digital is headquartered in Edwards, Colorado, in the Vail Valley. It provides IT services to small businesses nationwide, and created Vail Valley IT to focus on its home community.' },
  { q: 'Is Vail Valley IT hiring?', a: 'We are always interested in hearing from talented people in the Vail Valley, even when no position is advertised. You can send a resume through the careers page.' },
];
---
<Base title={title} description={description} path="/about" schema={[webPage('/about', title, description, 'AboutPage'), founder(), breadcrumbs(crumbs), faqPage(faqs, '/about')]}>
  <header class="page-head"><div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>About Vail Valley IT</h1>
    <p class="answer">Vail Valley IT is the local branch of DubLow Digital, a nationwide IT firm for small businesses headquartered right here in Edwards, Colorado. We created Vail Valley IT to focus on our own community: to give Eagle County businesses enterprise-grade IT, security, automation and marketing from longtime locals who live here and answer the phone.</p>
  </div></header>
  <section class="section"><div class="wrap article">
    <article class="prose">
      <h2>Headquartered in the Vail Valley, serving small businesses nationwide</h2>
      <p><a href={site.parentUrl}>{site.parentBrand}</a> is an IT firm for small businesses across the country, and it has always been headquartered in {site.parentHq}. The tools, security stack, help desk and processes we use for clients nationwide are the same ones behind every Vail Valley IT client.</p>
      <h2>Why we created Vail Valley IT</h2>
      <p>We are longtime locals. This is where we live, work and play, and the businesses that keep the valley running are our neighbors. Vail Valley IT is the branch we built to focus on that community and to grow here: managed IT, cybersecurity, compliance, automation and digital marketing for businesses between Vail Pass and Dotsero, delivered by people who are a short drive away instead of a ticket number in another state.</p>
      <p>It also means local practices, agencies, lodges and contractors no longer have to choose between a national provider that does not know the valley and break-fix help that only shows up after something breaks.</p>
      <h2>Cyber-first and automation-driven</h2>
      <p>Security is where every engagement starts. Before we recommend hardware or software, we assess the risk to your data. And because we run our own operation on automation, routine requests like new users and password or MFA resets for verified staff are resolved in about ten minutes instead of hours, while every other request reaches the right human technician faster. We help clients adopt the same approach so their teams spend less time on repetitive work.</p>
      <section class="founder" id="todd-whitelow" aria-labelledby="founder-h">
        <div class="founder-photo">
          <Image src={founderPhoto} alt={`${site.founder.name}, founder of ${site.parentBrand} and Vail Valley IT`} widths={[240, 400, 600]} sizes="(max-width: 640px) 160px, 240px" loading="lazy" />
        </div>
        <div class="founder-body">
          <span class="founder-eyebrow">Meet the founder</span>
          <h2 id="founder-h">{site.founder.name}</h2>
          <p class="founder-role">Founder, {site.parentBrand} &amp; Vail Valley IT</p>
          <ul class="founder-tags">
            <li><Icon name="pin" />Edwards, CO</li>
            <li><Icon name="heart" />Longtime local</li>
            <li><Icon name="headset" />Hands-on with clients</li>
          </ul>
          <p>Todd founded DubLow Digital and leads Vail Valley IT. He lives in the valley, works directly with clients across Eagle County, and leads a team of technicians and specialists backed by a dedicated help desk and network operations partner.</p>
          <p class="founder-focus">IT that protects the business, gets out of the way, and pays for itself.</p>
          <p class="founder-links"><a href="/reviews-testimonials">Client reviews</a><a href="/case-studies">Case studies</a><a href="/workshops-webinars">Workshops</a></p>
        </div>
      </section>
      <h2>How we work</h2>
      <ul class="included">
        <li><Icon name="check" />Security risk assessment before any recommendation</li>
        <li><Icon name="check" />Flat, written pricing with no surprise invoices</li>
        <li><Icon name="check" />Documentation of every system we manage, which you own</li>
        <li><Icon name="check" />Quarterly reviews with plain-language reporting</li>
        <li><Icon name="check" />Automation for speed, people for judgment</li>
      </ul>
      <div style="margin-top:2.5rem"><Faq faqs={faqs} /></div>
    </article>
    <aside class="aside">
      <div class="box"><h3>Company facts</h3>
        <table><tbody>
          <tr><th scope="row">Brand</th><td>{site.name}</td></tr>
          <tr><th scope="row">Parent</th><td><a href={site.parentUrl}>{site.parentBrand}</a></td></tr>
          <tr><th scope="row">Parent HQ</th><td>{site.parentHq}</td></tr>
          <tr><th scope="row">Parent reach</th><td>Small businesses nationwide</td></tr>
          <tr><th scope="row">Based in</th><td>{site.address.locality}, {site.address.region}</td></tr>
          <tr><th scope="row">Serves</th><td>Eagle County, CO</td></tr>
          <tr><th scope="row">Phone</th><td>{site.phone}</td></tr>
          <tr><th scope="row">Careers</th><td><a href="/careers">Send us your resume</a></td></tr>
          <tr><th scope="row">Reviews</th><td><a href="/reviews-testimonials">{site.gbp.rating.toFixed(1)} ★ on Google{site.gbp.reviewCount ? ` (${site.gbp.reviewCount})` : ''}</a></td></tr>
        </tbody></table>
      </div>
    </aside>
  </div></section>
  <CtaBand />
</Base>
