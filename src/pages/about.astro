---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
import { breadcrumbs, webPage, founder, faqPage } from '../lib/schema';
const title = 'About Vail Valley IT | Local Managed IT Services Team';
const description = 'Vail Valley IT is the local managed technology services brand of DubLow Digital, built to serve Eagle County businesses from Edwards, Colorado.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }];
const faqs = [
  { q: 'Is Vail Valley IT a local company?', a: 'Yes. Vail Valley IT is based in Edwards, Colorado, and its founder lives in the Vail Valley. It serves businesses throughout Eagle County.' },
  { q: 'Who owns Vail Valley IT?', a: 'Vail Valley IT is a brand of DubLow Digital, founded by Todd Whitelow. DubLow Digital is the parent company; Vail Valley IT is its local IT, cybersecurity and automation practice.' },
];
---
<Base title={title} description={description} path="/about" schema={[webPage('/about', title, description, 'AboutPage'), founder(), breadcrumbs(crumbs), faqPage(faqs, '/about')]}>
  <header class="page-head"><div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>About Vail Valley IT</h1>
    <p class="answer">Vail Valley IT is the local managed technology services brand of DubLow Digital, based in Edwards, Colorado. We exist for one reason: to give Eagle County businesses enterprise-grade IT, security and automation from people who live here and answer the phone.</p>
  </div></header>
  <section class="section"><div class="wrap article">
    <article class="prose">
      <h2>Why we built a local IT brand</h2>
      <p>For years, the best-known names in Vail Valley IT search results have been regional and national firms serving many markets at once. Meanwhile, local practices, agencies, lodges and contractors have been getting by with break-fix calls and good intentions. Vail Valley IT is focused only on that gap: managed IT, cybersecurity, compliance, automation and digital marketing for businesses between Vail Pass and Dotsero.</p>
      <h2>Cyber-first and automation-driven</h2>
      <p>Security is where every engagement starts. Before we recommend hardware or software, we assess the risk to your data. And because we run our own operation on automation, routine requests like new users and password or MFA resets for verified staff are resolved in about ten minutes instead of hours, while every other request reaches the right human technician faster. We help clients adopt the same approach so their teams spend less time on repetitive work.</p>
      <h2 id="todd-whitelow">Meet the founder</h2>
      <p><strong>{site.founder.name}</strong> founded DubLow Digital and leads Vail Valley IT. He lives in the Vail Valley, works hands-on with clients across Eagle County, and leads a team of technicians and specialists backed by a dedicated help desk and network operations partner. His focus is simple: IT that protects the business, gets out of the way, and pays for itself.</p>
      <p>See the work in <a href="/case-studies">case studies</a> and <a href="/reviews-testimonials">client reviews</a>, or catch Todd at a free <a href="/workshops-webinars">workshop or webinar</a>.</p>
      <h2>How we work</h2>
      <ul class="included">
        <li><Icon name="check" />Security risk assessment before any recommendation</li>
        <li><Icon name="check" />Flat, written pricing with no surprise invoices</li>
        <li><Icon name="check" />Documentation of every system we manage, which you own</li>
        <li><Icon name="check" />Quarterly reviews with plain-language reporting</li>
        <li><Icon name="check" />Automation for speed, people for judgment</li>
      </ul>
      <div style="margin-top:2.5rem"><Faq faqs={faqs} /></div>
    </article>
    <aside class="aside">
      <div class="box"><h3>Company facts</h3>
        <table><tbody>
          <tr><th scope="row">Brand</th><td>{site.name}</td></tr>
          <tr><th scope="row">Parent</th><td><a href={site.parentUrl}>{site.parentBrand}</a></td></tr>
          <tr><th scope="row">Based in</th><td>{site.address.locality}, {site.address.region}</td></tr>
          <tr><th scope="row">Serves</th><td>Eagle County, CO</td></tr>
          <tr><th scope="row">Phone</th><td>{site.phone}</td></tr>
          <tr><th scope="row">Reviews</th><td><a href="/reviews-testimonials">{site.gbp.rating.toFixed(1)} ★ ({site.gbp.reviewCount})</a></td></tr>
        </tbody></table>
      </div>
    </aside>
  </div></section>
  <CtaBand />
</Base>
